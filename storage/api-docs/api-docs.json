    "components": {
        "schemas": {
            "ContactStatusEnum": {
                "description": "Status do contato",
                "type": "string",
                "enum": [
                    "PENDING",
                    "WAITING_RESPONSE",
                    "ANSWERED",
                    "ARCHIVED"
                ]
            },
            "ApiErrorDTO": {
                "properties": {
                    "path": {
                        "type": "string",
                        "example": "/api/route"
                    },
                    "code": {
                        "type": "integer",
                        "example": 500
                    },
                    "message": {
                        "type": "string",
                        "example": "Error ocurried"
                    }
                },
                "type": "object"
            },
            "ContactRequest": {
                "required": [
                    "name",
                    "email",
                    "subject",
                    "message",
                    "status"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 2,
                        "example": "João"
                    },
                    "email": {
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 3,
                        "example": "joao@email.com"
                    },
                    "subject": {
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 3,
                        "example": "Oferta de emprego"
                    },
                    "message": {
                        "type": "string",
                        "minLength": 4,
                        "example": "<p>Boa tarde!</p><p>Tenho uma oferta de emprego para você</p>"
                    },
                    "status": {
                        "$ref": "#/components/schemas/ContactStatusEnum"
                    }
                },
                "type": "object"
            },
            "ProjectTypeRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 40,
                        "minLength": 1,
                        "example": "Back-end"
                    }
                },
                "type": "object"
            },
            "TagRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 1,
                        "example": "API"
                    }
                },
                "type": "object"
            },
            "TechnologyRequest": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "maxLength": 80,
                        "minLength": 1,
                        "example": "Laravel"
                    }
                },
                "type": "object"
            },
            "Contact": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "João"
                    },
                    "email": {
                        "type": "string",
                        "example": "joao@email.com"
                    },
                    "subject": {
                        "type": "string",
                        "example": "Oferta de emprego"
                    },
                    "message": {
                        "type": "string",
                        "example": "<p>Boa tarde!</p><p>Tenho uma oferta de emprego para você</p>"
                    },
                    "status": {
                        "$ref": "#/components/schemas/ContactStatusEnum"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-28T11:23:31.000000Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-28T11:23:31.000000Z"
                    }
                },
                "type": "object"
            },
            "ProjectType": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Back-end"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-28T11:23:31.000000Z"
                    },
                    "updated_at": {
